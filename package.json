{
  "name": "bloom",
  "productName": "Bloom",
  "version": "0.2.0",
  "description": "Bloom — a soft, simple shared calendar.",
  "author": "Bloom",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "node scripts/build-electron.mjs && wait-on tcp:5173 && cross-env-shell VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev:web": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/build-electron.mjs",
    "test": "vitest run",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:linux": "npm run build && electron-builder --linux dir --publish never"
  },
  "build": {
    "appId": "app.bloom.calendar",
    "productName": "Bloom",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Bloom-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bloom",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Bloom-Setup-${version}.${ext}"
    },
    "linux": {
      "target": "dir",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sosaclosa123",
        "repo": "bloom",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/gveret-levin": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@hebcal/core": "^6.16.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "firebase": "^13.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/status-bar": "^8.0.3",
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sosaclosa123/bloom.git"
  }
}
